### [fake08_fullscreen] :[enabled] :[enabled|disabled]
fake08_fullscreen = "enabled"

### [fake08_audio] :[enabled] :[enabled|disabled]
fake08_audio = "enabled"

### [fake08_audio_channels] :[4] :[4|3|2|1]
fake08_audio_channels = "4"

### [fake08_frameskip] :[0] :[0|1|2|3]
fake08_frameskip = "0"

### [fake08_video_scale] :[1x] :[1x|2x]
fake08_video_scale = "1x"

### [fake08_crop_h_left] :[0] :[0|4|8|12|16]
fake08_crop_h_left = "0"

### [fake08_crop_h_right] :[0] :[0|4|8|12|16]
fake08_crop_h_right = "0"

### [fake08_crop_v_top] :[0] :[0|4|8|12|16]
fake08_crop_v_top = "0"

### [fake08_crop_v_bottom] :[0] :[0|4|8|12|16]
fake08_crop_v_bottom = "0"

### [sf2000_scaling_mode] :[full_screen] :[full_screen|core_provided|square_pixels|stock|custom]
sf2000_scaling_mode = "full_screen"

### [sf2000_scaling_filtered] :[true] :[true|false]
sf2000_scaling_filtered = "true"

### [sf2000_tearing_fix] :[off] :[off|rotate|repeat|split]
sf2000_tearing_fix = "off"

### [sf2000_show_fps] :[false] :[true|false]
sf2000_show_fps = "false"

### [sf2000_enable_frogui_patch] :[true] :[true|false]
sf2000_enable_frogui_patch = "true"

### [sf2000_enable_osd] :[true] :[true|false]
sf2000_enable_osd = "true"

### [sf2000_osd_small_messages] :[true] :[true|false]
sf2000_osd_small_messages = "true"

### [sf2000_enable_darken_filter] :[false] :[true|false]
sf2000_enable_darken_filter = "false"

### [sf2000_darken_percentage] :[20] :[10|20|30|40|50]
sf2000_darken_percentage = "20"

### [sf2000_enable_darken_hotkey] :[false] :[true|false]
sf2000_enable_darken_hotkey = "false"

### [sf2000_enable_screenshot_hotkey] :[true] :[true|false]
sf2000_enable_screenshot_hotkey = "true"
